# Copy to .env.local and fill in. Restart `next dev` after changes.
# The same names must exist in Vercel for both Production and Preview.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_ or import into client components.
# Bypasses RLS; used for the public lead insert and admin reads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (send-only key is enough) for new-lead notification emails.
RESEND_API_KEY=re_your_key

# Public base URL, used for canonical links, Open Graph tags, the sitemap,
# robots.txt and links in notifications.
NEXT_PUBLIC_SITE_URL=https://blue-peak-omega.vercel.app

# Set to exactly "true" to let search engines index the site. Any other value,
# or leaving it unset, makes every page noindex and robots.txt disallow
# everything. Leave unset until the placeholder content is replaced; it is
# inlined at build time, so redeploy after changing it.
# NEXT_PUBLIC_SITE_LIVE=true

# ntfy topic URL (e.g. https://ntfy.sh/your-topic) that receives a push for
# every new lead, alongside the email. Everyone subscribed to it is notified.
NTFY_TOPIC_URL=

# Cloudflare Turnstile (invisible bot check on the lead forms). Create a widget
# in the Cloudflare dashboard (Turnstile > Add widget, mode "Invisible") with
# the site's hostnames. Enforced only when BOTH keys are set; without them the
# forms still work, protected by the honeypot and rate limit only.
# Local testing: site key 1x00000000000000000000BB with secret
# 1x0000000000000000000000000000000AA always passes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Bearer token for /api/cron/lead-reminders (stalled-lead ntfy reminders).
# Must match the `lead_reminders_cron_secret` Vault secret in Supabase, whose
# hourly pg_cron job calls the endpoint.
CRON_SECRET=

# Optional. Slack or Discord incoming-webhook URL that receives an alert when
# a new-lead email fails to send, so a Resend outage is never silent.
LEAD_ALERT_WEBHOOK_URL=
