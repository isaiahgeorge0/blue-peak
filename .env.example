# Copy to .env.local and fill in. Restart `next dev` after changes.
# The same names must exist in Vercel for both Production and Preview.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_ or import into client components.
# Bypasses RLS; used for the public lead insert and admin reads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (send-only key is enough) for new-lead notification emails.
RESEND_API_KEY=re_your_key

# Public base URL, used for canonical links, Open Graph tags, the sitemap,
# robots.txt and links in notifications.
NEXT_PUBLIC_SITE_URL=https://blue-peak-omega.vercel.app

# Set to exactly "true" to let search engines index the site. Any other value,
# or leaving it unset, makes every page noindex and robots.txt disallow
# everything. Leave unset until the placeholder content is replaced; it is
# inlined at build time, so redeploy after changing it.
# NEXT_PUBLIC_SITE_LIVE=true

# ntfy topic URL (e.g. https://ntfy.sh/your-topic) that receives a push for
# every new lead, alongside the email. Everyone subscribed to it is notified.
NTFY_TOPIC_URL=

# Cloudflare Turnstile (invisible bot check on the lead forms). Create a widget
# in the Cloudflare dashboard (Turnstile > Add widget, mode "Invisible") with
# the site's hostnames. Enforced only when BOTH keys are set; without them the
# forms still work, protected by the honeypot and rate limit only.
# Local testing: site key 1x00000000000000000000BB with secret
# 1x0000000000000000000000000000000AA always passes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Bearer token for /api/cron/lead-reminders (stalled-lead ntfy reminders).
# Must match the `lead_reminders_cron_secret` Vault secret in Supabase, whose
# hourly pg_cron job calls the endpoint.
CRON_SECRET=

# Optional. Slack or Discord incoming-webhook URL that receives an alert when
# a new-lead email fails to send, so a Resend outage is never silent.
LEAD_ALERT_WEBHOOK_URL=

# Follow-up emails to customers (acknowledgement, two quote chasers, review
# request), sent by /api/cron/follow-ups. A Supabase pg_cron job calls it every
# 5 minutes once the `follow_ups_url` Vault secret exists, with the same
# bearer token as the reminders (CRON_SECRET). Templates and on/off per step
# are edited in the admin under Follow-ups.
#
# Master switch. Unless this is exactly "true", nothing is sent: anything that
# falls due is logged as skipped and is never sent later.
FOLLOW_UPS_ENABLED=
# Sender, e.g. "Blue Peak <hello@yourdomain.co.uk>", on a domain verified in
# Resend. Nothing is sent while this is unset.
FOLLOW_UP_FROM=
# Where customer replies go (every follow-up has this reply-to). Nothing is
# sent while this is unset.
FOLLOW_UP_REPLY_TO=
# Testing only. When set, every follow-up goes to this address instead of the
# customer, with the customer's address shown at the top of the email. The two
# test leads only receive follow-ups while this is set.
FOLLOW_UP_TEST_RECIPIENT=
# Link for the review request's "Leave a Google review" button. While unset,
# review requests are skipped and logged as skipped.
GOOGLE_REVIEW_URL=
# Local testing only; never set in Vercel (ignored there anyway). Lets
# /api/cron/follow-ups take ?now=<ISO time> and requires ?lead=<id> to limit
# a run to those leads.
# FOLLOW_UP_LOCAL_TESTING=true

# Optional. Address that "Ask about adding this" on the admin add-on pages
# emails (a mailto: link with the add-on's name in the subject). Leave unset to
# hide the button.
ADDON_CONTACT_EMAIL=
